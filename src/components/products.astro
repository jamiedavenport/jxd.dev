---
import { products } from "../data/products";
---

<section>
  <h2 class="font-mono text-sm uppercase text-gray-700 mb-2">My Projects</h2>
  <ul
    class="border rounded-lg border-gray-300 overflow-hidden divide-y divide-gray-300 -mx-4 [&_li]:hover:bg-white"
  >
    {
      products.map((project) => (
        <li>
          <a
            href={project.href}
            target="_blank"
            class="p-4 flex flex-col"
          >
            {project.openSource ? (
              <p class="flex items-center gap-2">
                <span class="font-bold">{project.title}</span>
                <span class="text-xs text-gray-500 font-mono">Open Source</span>
              </p>
            ) : (
              <span class="font-bold">{project.title}</span>
            )}
            <span class="text-sm text-gray-700">{project.description}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
