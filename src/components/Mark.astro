---
import { site } from "@/lib/site";

interface Props {
  small?: boolean;
}

const { small = false } = Astro.props;
---

<img
  class:list={["shrink-0", small ? "size-8" : "size-12"]}
  src={site.mark}
  alt={small ? "" : site.name}
  width="16"
  height="16"
  fetchpriority="high"
  data-mark
  transition:name="jxd-mark"
  transition:animate="initial"
/>
