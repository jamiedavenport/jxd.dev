---
import { ArrowTopRightOnSquareIcon, DocumentTextIcon } from "@heroicons/react/16/solid";
import { caseStudyURL, getCaseStudies } from "@/lib/content";

const studies = await getCaseStudies();

const buttonClass =
  "inline-flex items-center gap-1 whitespace-nowrap rounded-md px-2 py-1 max-sm:p-1.5 text-xs/5 font-medium text-zinc-800 no-underline transition-colors duration-180 ease-in-out hover:bg-zinc-950/5 hover:text-zinc-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-800";
---

<div class="overflow-hidden rounded-xl border border-zinc-950/12 bg-white">
  <table class="w-full border-collapse text-left">
    <caption class="sr-only">Case studies</caption>
    <tbody class="divide-y divide-zinc-950/8">
      {studies.map((study) => (
        <tr>
          <th class="py-2 pr-2 pl-4 font-medium text-zinc-800" scope="row">
            <span class="flex items-start gap-3">
              <span class="flex h-lh shrink-0 items-center">
                <img
                  class="size-4 rounded-sm object-contain"
                  src={study.data.icon}
                  alt=""
                  width="16"
                  height="16"
                />
              </span>
              <span class="grid">
                {study.data.client}
                <span class="text-xs/5 font-normal text-zinc-500">{study.data.summary}</span>
              </span>
            </span>
          </th>
          <td class="py-2 pr-2 pl-2 align-middle">
            <div class="flex justify-end gap-1">
              <a
                class={buttonClass}
                href={caseStudyURL(study.id)}
                aria-label={`${study.data.client} case study`}
              >
                <DocumentTextIcon className="size-3.5 shrink-0" aria-hidden="true" />
                <span class="max-sm:sr-only">Case study</span>
              </a>
              {study.data.website && (
                <a
                  class={buttonClass}
                  href={study.data.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${study.data.client} website`}
                >
                  <ArrowTopRightOnSquareIcon className="size-3.5 shrink-0" aria-hidden="true" />
                  <span class="max-sm:sr-only">Website</span>
                </a>
              )}
            </div>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
