---
import Layout from "@/layouts/Layout.astro";
import { site } from "@/lib/site";
import "@/styles/prose.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<Layout editorial title={`${title} | ${site.name}`} description={description}>
  <div class="py-16 tracking-[-0.015em] sm:py-24">
    <article class="mx-auto w-full max-w-[calc(65ch+3rem)] px-6 text-base/7 sm:text-sm/6.5">
      <header class="mb-12">
        <h1 class="text-3xl font-semibold tracking-tight text-pretty text-zinc-900 sm:text-4xl">{title}</h1>
      </header>
      <div class="prose prose-zinc article-prose max-w-[65ch] text-base/7 wrap-anywhere sm:prose-sm sm:text-sm/6.5 prose-headings:font-semibold prose-headings:text-pretty prose-strong:font-semibold prose-th:whitespace-nowrap">
        <slot />
      </div>
      <div class="mt-14 text-base/7 text-zinc-500 sm:text-sm/6.5">
        <a class="no-underline hover:text-zinc-950 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-800" href="/">Back home</a>
      </div>
    </article>
  </div>
</Layout>
