---
import "@/styles/global.css";
import type { ImageMetadata } from "astro";
import { ClientRouter } from "astro:transitions";
import { site } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
  editorial?: boolean;
  noindex?: boolean;
  canonicalPath?: string;
  ogImage?: {
    src: ImageMetadata;
    alt: string;
  };
  article?: {
    title: string;
    publishedAt: Date;
    updatedAt?: Date;
  };
}

const {
  title = "JXD | Serious software, shipped in weeks",
  description = site.description,
  editorial = false,
  noindex = false,
  canonicalPath = Astro.url.pathname,
  article,
  ogImage,
} = Astro.props;

const canonicalURL = new URL(canonicalPath, Astro.site);
const homeURL = new URL("/", Astro.site).href;
const markURL = new URL(site.mark, Astro.site).href;
const socialImage = ogImage ? {
  url: new URL(ogImage.src.src, Astro.site).href,
  type: `image/${ogImage.src.format === "jpg" ? "jpeg" : ogImage.src.format}`,
  width: ogImage.src.width,
  height: ogImage.src.height,
  alt: ogImage.alt,
} : undefined;
const contentFade = {
  old: { name: "content-fade-out", duration: "140ms", easing: "ease-in", fillMode: "both" },
  new: { name: "content-fade-in", duration: "160ms", delay: "140ms", easing: "ease-out", fillMode: "both" },
};
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${homeURL}#website`,
      url: homeURL,
      name: site.name,
      inLanguage: "en-GB",
      publisher: { "@id": `${homeURL}#organization` },
    },
    ...(article ? [{
      "@type": "BlogPosting",
      "@id": `${canonicalURL.href}#article`,
      url: canonicalURL.href,
      headline: article.title,
      description,
      ...(socialImage ? { image: socialImage.url } : {}),
      datePublished: article.publishedAt.toISOString(),
      dateModified: (article.updatedAt ?? article.publishedAt).toISOString(),
      inLanguage: "en-GB",
      author: { "@id": `${homeURL}#organization` },
      publisher: { "@id": `${homeURL}#organization` },
      isPartOf: { "@id": `${homeURL}#website` },
      mainEntityOfPage: canonicalURL.href,
    }] : []),
    {
      "@type": "ProfessionalService",
      "@id": `${homeURL}#organization`,
      name: site.name,
      legalName: site.legalName,
      url: homeURL,
      logo: markURL,
      email: site.email,
      description: site.description,
      address: {
        "@type": "PostalAddress",
        addressLocality: "London",
        addressCountry: "GB",
      },
    },
  ],
};
---

<!doctype html>
<html lang="en-GB" transition:animate="none">
  <head>
    <ClientRouter />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fdfdfc" />
    <meta name="color-scheme" content="light" />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"}
    />
    {!noindex && (
      <>
        <link rel="canonical" href={canonicalURL} />
        <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
        <meta property="og:type" content={article ? "article" : "website"} />
        <meta property="og:site_name" content={site.name} />
        <meta property="og:locale" content="en_GB" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL} />
        {socialImage && (
          <>
            <meta property="og:image" content={socialImage.url} />
            <meta property="og:image:type" content={socialImage.type} />
            <meta property="og:image:width" content={String(socialImage.width)} />
            <meta property="og:image:height" content={String(socialImage.height)} />
            <meta property="og:image:alt" content={socialImage.alt} />
            <meta name="twitter:image" content={socialImage.url} />
            <meta name="twitter:image:alt" content={socialImage.alt} />
          </>
        )}
        {article && (
          <>
            <meta property="article:published_time" content={article.publishedAt.toISOString()} />
            {article.updatedAt && <meta property="article:modified_time" content={article.updatedAt.toISOString()} />}
          </>
        )}
        <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
        />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href={site.mark} />
    <link
      rel="preload"
      href="/fonts/InterVariable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-[#fdfdfc] font-sans text-zinc-950 antialiased">
    <main
      class:list={[
        "isolate outline-none",
        !editorial && "mx-auto flex min-h-dvh max-w-2xl flex-col justify-center px-6 py-20 sm:px-10",
      ]}
      tabindex="-1"
      transition:name="page-content"
      transition:animate={{ forwards: contentFade, backwards: contentFade }}
    >
      <slot />
    </main>
    <script>
      import { OpenPanel } from "@openpanel/web";

      document.addEventListener("astro:before-preparation", () => {
        const mark = document.querySelector<HTMLElement>("[data-mark]");
        if (!mark) {
          return;
        }
        const bounds = mark.getBoundingClientRect();
        // An off-screen mark has no useful snapshot to morph from.
        if (bounds.bottom <= 0 || bounds.top >= window.innerHeight) {
          mark.style.viewTransitionName = "none";
        }
      });

      document.addEventListener("astro:after-swap", () => {
        const destination = window.location.hash === "#writing"
          ? document.getElementById("writing")
          : document.querySelector<HTMLElement>("main");
        destination?.focus({ preventScroll: true });
      });

      document.addEventListener("astro:page-load", () => {
        document.querySelector<HTMLElement>("[data-mark]")?.style.removeProperty("view-transition-name");
      });

      if (import.meta.env.DEV) {
        // Pages without React islands lack the Fast Refresh preamble the dev React build expects.
        const refresh = window as unknown as Record<string, unknown>;
        refresh.$RefreshReg$ ??= () => {};
        refresh.$RefreshSig$ ??= () => (type: unknown) => type;
        void import("@/lib/agentation");
      }

      if (import.meta.env.PROD) {
        const analytics = new OpenPanel({
          clientId: "a6f6914d-fb80-47b0-aabc-a2c167c60826",
          trackScreenViews: false,
          trackOutgoingLinks: true,
        });
        document.addEventListener("astro:page-load", () => {
          analytics.screenView(`${window.location.origin}${window.location.pathname}${window.location.search}`);
        });
      }
    </script>
  </body>
</html>
