---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/base.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} by Jamie Davenport`} description={post.data.summary}>
  <div class="min-h-screen flex flex-col justify-center items-center p-10">
    <div class="max-w-sm w-full text-sm flex flex-col gap-5">
      <a href="/" class="text-sm w-fit hover:underline">
        Back to home
      </a>

      <h1 class="text-lg font-bold">
        {post.data.title}
      </h1>

      <div class="prose prose-sm prose-gray-700 max-w-none">
        <Content />
      </div>

      <a href="/" class="text-sm w-fit hover:underline">
        Back to home
      </a>
    </div>
  </div>
</BaseLayout>
