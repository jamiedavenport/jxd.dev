---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="JXD"
  description="Software engineer, entrepreneur, and investor based in the UK."
  ogUrl="https://jxd.dev"
>
  <!-- <section>
    <h2 class="font-mono font-medium text-xs text-gray-500 mb-2">
      README.md
    </h2>
    <p>

    </p>
  </section> -->

  <section>
    <h2 class="font-mono font-medium text-xs text-gray-500 mb-4">
      PROJECTS.md
    </h2>
    <div class="grid grid-cols-3 gap-px bg-gray-200 border border-gray-200">
      <a class="group col-span-2 bg-white p-6 hover:bg-gray-50 flex flex-col gap-3" href="https://policystack.dev" target="_blank">
        <div class="flex items-center justify-between">
          <span class="font-mono text-[0.625rem] text-gray-400 uppercase tracking-wide">Featured</span>
          <span class="font-mono text-xs text-gray-400 group-hover:translate-x-0.5 transition-transform">↗</span>
        </div>
        <div>
          <p class="font-mono font-medium text-sm mb-1">PolicyStack</p>
          <p class="text-xs text-gray-500 max-w-[42ch]">Privacy and consent as code — open building blocks for policies, banners, and developer-first compliance.</p>
        </div>
      </a>
      <a class="bg-white p-4 hover:bg-gray-50 flex flex-col" href="https://github.com/jamiedavenport/openpolicy" target="_blank">
        <p class="font-mono font-medium text-xs mb-1">OpenPolicy</p>
        <p class="text-xs text-gray-500">Privacy-first primitives for React</p>
      </a>
      <a class="bg-white p-4 hover:bg-gray-50 flex flex-col" href="https://github.com/jamiedavenport/opencookies" target="_blank">
        <p class="font-mono font-medium text-xs mb-1">OpenCookies</p>
        <p class="text-xs text-gray-500">Headless cookie consent primitives</p>
      </a>
      <a class="bg-white p-4 hover:bg-gray-50 flex flex-col" href="https://offstage.sh" target="_blank">
        <p class="font-mono font-medium text-xs mb-1">Offstage</p>
        <p class="text-xs text-gray-500">Conversational analytics for coding agents</p>
      </a>
      <a class="bg-white p-4 hover:bg-gray-50 flex flex-col" href="https://lucid.jxd.dev" target="_blank">
        <p class="font-mono font-medium text-xs mb-1">Lucid</p>
        <p class="text-xs text-gray-500">Productivity platform for distracted minds</p>
      </a>
    </div>
  </section>

  <section>
    <h2 class="font-mono font-medium text-xs text-gray-500 mb-4">BLOG.md</h2>
    <ul class="flex flex-col">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`} class="block py-4 hover:bg-gray-50 transition-colors -mx-4 px-4">
            <p class="font-medium mb-1">{post.data.title}</p>
            <p class="text-sm text-gray-500 mb-2">{post.data.summary}</p>
            <p class="font-mono text-xs text-gray-400">
              {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
            </p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
