---
import { getCollection } from "astro:content";
import "../styles/global.css";
import BaseLayout from "../layouts/base.astro";

const posts = await getCollection("blog");

const sortedPosts = posts.filter((post) => post.data.ranking > 0).sort((a, b) => b.data.ranking - a.data.ranking);

const projects = [
{
  title: "Big Journal",
  href: "https://bigjournal.app",
  description: "Beautiful, AI-powered journaling.",
},
{
  title: "Feedback",
  href: "https://github.com/jamiedavenport/feedback",
  description: "Headless customer feedback platform.",
  openSource: true,
},
  {
    title: "Forgotten",
    href: "https://forgotten.app",
    description: "Bookmark manager for developers.",
  },
  {
    title: "Gotowy",
    href: "https://gotowy.jxd.dev",
    description: "AI-native, minimalist task management.",
  },
  {
    "title": "Hype",
    href: "https://buildhype.dev",
    description: "Open-source toolkit for building waitlists.",
    openSource: true,
  },
  {
    title: "Starter",
    href: "https://github.com/jxdltd/holistic-starter",
    description: "TanStack-based starter kit for building web apps at speed.",
    openSource: true,
  },
  {
    title: "Quadratic",
    href: "https://github.com/jxdltd/quadratic-v2",
    description: "Feedback widget built for Linear.",
    openSource: true,
  }
]
---

<BaseLayout>
    <div class="flex flex-col gap-10 p-16 mx-auto max-w-xl">
      <div class="flex flex-col gap-2">
        <h1 class="text-4xl leading-none font-black mb-3">
          <span>Jamie</span>
          <span>Davenport</span>
        </h1>
        <p
          class="flex items-center gap-2 text-sm text-gray-500 font-mono [&>svg]:size-4"
        >
          <svg
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
          >
            <path
              d="M7 2h10v2H7V2zM5 6V4h2v2H5zm0 8H3V6h2v8zm2 2H5v-2h2v2zm2 2H7v-2h2v2zm2 2H9v-2h2v2zm2 0v2h-2v-2h2zm2-2v2h-2v-2h2zm2-2v2h-2v-2h2zm2-2v2h-2v-2h2zm0-8h2v8h-2V6zm0 0V4h-2v2h2zm-5 2h-4v4h4V8z"
              fill="currentColor"></path>
          </svg>
          <span>London, UK</span>
        </p>
        <p>Software engineer, entrepreneur, and investor based from the UK.</p>
        <p>
          Previously the founder of <a
            href="https://www.uktech.news/saas/docbot-labs-pre-seed-20221102"
            target="_blank"
            class="border-b border-dashed border-gray-500 hover:border-gray-700"
            >Docbot Labs</a
          >. I've helped a number of startups go from 0 to 1.
        </p>
        <p>Fancy a chat? <a href="https://cal.com/jamie-davenport/consultation" target="_blank" class="border-b border-dashed border-gray-500 hover:border-gray-700">Book a call</a>.</p>
      </div>

      <a href="https://my.forgotten.app/t/441d7dfd-00a3-42bd-b07c-9e03132d5ee8" target="_blank" class="p-4 flex flex-col rounded-lg border border-gray-300 -mx-4 hover:bg-white">
        <span class="font-bold">Tech Stack</span>
        <span class="text-sm text-gray-700">Check out the tools I use to build software.</span>
      </a>

      <section>
        <h2 class="font-mono text-sm uppercase text-gray-700 mb-2">Projects</h2>
        <!-- <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Quisquam, quos.</p> -->
        <ul
          class="border rounded-lg border-gray-300 overflow-hidden divide-y divide-gray-300 -mx-4 [&_li]:hover:bg-white"
        >
          {
            projects.map((project) => (
              <li>
                <a
                  href={project.href}
                  target="_blank"
                  class="p-4 flex flex-col"
                >
                  {project.openSource ? (
                    <p class="flex items-center gap-2">
                      <span class="font-bold">{project.title}</span>
                      <span class="text-xs text-gray-500 font-mono">Open Source</span>
                    </p>
                  ) : (
                    <span class="font-bold">{project.title}</span>
                  )}
                  <span class="text-sm text-gray-700">{project.description}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2 class="font-mono text-sm uppercase text-gray-700 mb-2">Writing</h2>
        <ul
          class="border rounded-lg border-gray-300 overflow-hidden divide-y divide-gray-300 -mx-4"
        >
          {
            sortedPosts.map((post) => (
              <li class="hover:bg-white">
                <a href={`/writing/${post.id}`} class="p-4 flex flex-col">
                  <span class="font-bold">{post.data.title}</span>
                  <span class="text-sm text-gray-700">{post.data.summary}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <footer class="flex items-center gap-4">
        <a
          href="https://github.com/jamiedavenport"
          target="_blank"
          class="text-gray-500 hover:text-gray-700 [&>svg]:size-5"
        >
          <svg
            role="img"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            fill="currentColor"
            ><title>GitHub</title><path
              d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
            ></path></svg
          ></a
        >
        <a
          href="https://x.com/jxd_dev"
          target="_blank"
          class="text-gray-500 hover:text-gray-700 [&>svg]:size-5"
        >
          <svg
            fill="currentColor"
            role="img"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><title>X</title><path
              d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"
            ></path></svg
          ></a
        >
      </footer>
    </div>
</BaseLayout>