---
import "../styles/global.css";
import BaseLayout from "../layouts/base.astro";
import Docbot from '../assets/docbot.svg';
import me from '../assets/me.jpeg?url';
import Lucid from '../assets/lucid.svg';
---

<BaseLayout>
  <div class="min-h-screen flex flex-col justify-center items-center p-10">
    <div class="max-w-sm w-full text-sm flex flex-col gap-5">
      <img src={me} alt="Jamie Davenport" class="size-10 rounded-full" />

        <h1 class="text-lg font-bold">Jamie Davenport</h1>

        <p>
          Currently building <a href="https://lucid.jxd.dev" target="_blank" class="inline-flex items-center gap-1 font-bold"><Lucid class="h-3 w-auto" /></a> - a productivity platform for those who struggle to stay focused.
        </p>

      <p>
        I'm a software engineer, entrepreneur and investor from <span
          class="whitespace-nowrap inline-flex items-center gap-1 h-[1em] font-bold"
          ><svg
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 32 32"
            class="size-4"
            ><rect
              x="1"
              y="4"
              width="30"
              height="24"
              rx="4"
              ry="4"
              fill="#071b65"></rect><path
              d="M5.101,4h-.101c-1.981,0-3.615,1.444-3.933,3.334L26.899,28h.101c1.981,0,3.615-1.444,3.933-3.334L5.101,4Z"
              fill="#fff"></path><path
              d="M22.25,19h-2.5l9.934,7.947c.387-.353,.704-.777,.929-1.257l-8.363-6.691Z"
              fill="#b92932"></path><path
              d="M1.387,6.309l8.363,6.691h2.5L2.316,5.053c-.387,.353-.704,.777-.929,1.257Z"
              fill="#b92932"></path><path
              d="M5,28h.101L30.933,7.334c-.318-1.891-1.952-3.334-3.933-3.334h-.101L1.067,24.666c.318,1.891,1.952,3.334,3.933,3.334Z"
              fill="#fff"></path><rect
              x="13"
              y="4"
              width="6"
              height="24"
              fill="#fff"></rect><rect
              x="1"
              y="13"
              width="30"
              height="6"
              fill="#fff"></rect><rect
              x="14"
              y="4"
              width="4"
              height="24"
              fill="#b92932"></rect><rect
              x="14"
              y="1"
              width="4"
              height="30"
              transform="translate(32) rotate(90)"
              fill="#b92932"></rect><path
              d="M28.222,4.21l-9.222,7.376v1.414h.75l9.943-7.94c-.419-.384-.918-.671-1.471-.85Z"
              fill="#b92932"></path><path
              d="M2.328,26.957c.414,.374,.904,.656,1.447,.832l9.225-7.38v-1.408h-.75L2.328,26.957Z"
              fill="#b92932"></path><path
              d="M27,4H5c-2.209,0-4,1.791-4,4V24c0,2.209,1.791,4,4,4H27c2.209,0,4-1.791,4-4V8c0-2.209-1.791-4-4-4Zm3,20c0,1.654-1.346,3-3,3H5c-1.654,0-3-1.346-3-3V8c0-1.654,1.346-3,3-3H27c1.654,0,3,1.346,3,3V24Z"
              opacity=".15"></path><path
              d="M27,5H5c-1.657,0-3,1.343-3,3v1c0-1.657,1.343-3,3-3H27c1.657,0,3,1.343,3,3v-1c0-1.657-1.343-3-3-3Z"
              fill="#fff"
              opacity=".2"></path></svg
          >London, UK</span
        >
      </p>

      <p>
        I previously founded <a href="https://www.uktech.news/saas/docbot-labs-pre-seed-20221102" target="_blank" class="inline-flex items-center gap-1 font-bold">
          <Docbot class="h-3 w-auto" />
          Docbot Labs
        </a> where I raised $600k in <span
          class="whitespace-nowrap">pre-seed</span
        > funding, but ultimately didn't find product-market fit.
      </p>

      <p>You can find me online at <a href="https://x.com/jamiedavenport_" target="_blank" class="inline-flex items-center gap-1 font-bold">
        <svg class="h-3" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><title>X</title><path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"/></svg>
        @jamiedavenport_
      </a>, <a href="https://jamiedavenport.bsky.social" target="_blank" class="inline-flex items-center gap-1 font-bold">
        <svg class="fill-[#1185FE] h-3" role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><title>Bluesky</title><path d="M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037-.856 3.061-3.978 3.842-6.755 3.37 4.854.826 6.089 3.562 3.422 6.299-5.065 5.196-7.28-1.304-7.847-2.97-.104-.305-.152-.448-.153-.327 0-.121-.05.022-.153.327-.568 1.666-2.782 8.166-7.847 2.97-2.667-2.737-1.432-5.473 3.422-6.3-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026"/></svg>
        @jamiedavenport
      </a> and <a href="https://github.com/jamiedavenport" target="_blank" class="inline-flex items-center gap-1 font-bold">
        <svg class="h-3" viewBox="0 0 1024 1024" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8C0 11.54 2.29 14.53 5.47 15.59C5.87 15.66 6.02 15.42 6.02 15.21C6.02 15.02 6.01 14.39 6.01 13.72C4 14.09 3.48 13.23 3.32 12.78C3.23 12.55 2.84 11.84 2.5 11.65C2.22 11.5 1.82 11.13 2.49 11.12C3.12 11.11 3.57 11.7 3.72 11.94C4.44 13.15 5.59 12.81 6.05 12.6C6.12 12.08 6.33 11.73 6.56 11.53C4.78 11.33 2.92 10.64 2.92 7.58C2.92 6.71 3.23 5.99 3.74 5.43C3.66 5.23 3.38 4.41 3.82 3.31C3.82 3.31 4.49 3.1 6.02 4.13C6.66 3.95 7.34 3.86 8.02 3.86C8.7 3.86 9.38 3.95 10.02 4.13C11.55 3.09 12.22 3.31 12.22 3.31C12.66 4.41 12.38 5.23 12.3 5.43C12.81 5.99 13.12 6.7 13.12 7.58C13.12 10.65 11.25 11.33 9.47 11.53C9.76 11.78 10.01 12.26 10.01 13.01C10.01 14.08 10 14.94 10 15.21C10 15.42 10.15 15.67 10.55 15.59C13.71 14.53 16 11.53 16 8C16 3.58 12.42 0 8 0Z" transform="scale(64)" fill="#1B1F23"/></svg>
        jamiedavenport
      </a></p>
    </div>
  </div>
</BaseLayout>
