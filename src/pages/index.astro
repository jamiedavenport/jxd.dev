---
import Layout from "@/layouts/Layout.astro";
import Mark from "@/components/Mark.astro";
import CaseStudies from "@/components/CaseStudies.astro";
import { site } from "@/lib/site";
import { formatDate, getPosts, postURL } from "@/lib/content";

const posts = await getPosts({ includeDrafts: import.meta.env.DEV });
---

<Layout editorial>
  <div
    class="flex min-h-dvh flex-col justify-center bg-[#fdfdfc] py-24 tracking-[-0.015em] max-sm:pt-12 max-sm:pb-16"
  >
    <div class="mx-auto w-full max-w-xl px-6">
      <Mark />

      <div
        class="mt-9 grid gap-5 text-base/7 text-zinc-600 sm:text-sm/6.5 [&_a]:font-medium [&_a]:text-zinc-800 [&_a]:no-underline [&_a:hover]:text-zinc-950 [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-4 [&_a:focus-visible]:outline-zinc-800 [&_p]:text-pretty"
      >
        <p>
          JXD is a software consultancy based in London. We build serious
          software for founders, startups and established businesses, and we
          ship it in weeks, not quarters.
        </p>
        <p>
          We take on three kinds of work. We build products and features from
          idea to production. We rescue struggling projects, vibe-coded apps
          included. And we embed senior engineers inside your team.
        </p>
        <p>
          Every engagement runs the same way. We ship to production from the
          first week, with a demo and a written note every week after. CI,
          tests and monitoring are in place from day one. You talk directly to
          the engineer doing the work, and when we leave, you own all of it.
        </p>
        <CaseStudies />
        <p>
          Tell us what you need to ship at <a href={`mailto:${site.email}`}
            >{site.email}</a
          >, or <a
            target="_blank"
            rel="noopener noreferrer"
            href={site.bookingURL}>book a 30-minute call</a
          >. You’ll get a clear yes or no within days.
        </p>
      </div>
      <div id="writing" class="scroll-mt-12 outline-none" tabindex="-1">
        {
          posts.length > 0 && (
            <ul
              class="mt-12 grid gap-1 text-base/7 sm:text-sm/6.5"
              role="list"
              aria-label="Writing"
            >
              {posts.map((post) => (
                <li class="grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-5">
                  <a
                    class="min-w-0 font-medium wrap-anywhere text-zinc-800 no-underline hover:text-zinc-950 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-800"
                    href={postURL(post.id)}
                  >
                    {post.data.title}
                    {post.data.draft && (
                      <span class="font-normal text-zinc-500"> (draft)</span>
                    )}
                  </a>
                  <time
                    class="text-right whitespace-nowrap text-zinc-500 tabular-nums"
                    datetime={post.data.publishedAt.toISOString()}
                  >
                    {formatDate(post.data.publishedAt)}
                  </time>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      <p class="mt-12 text-xs/5 text-zinc-500 [&_a]:text-zinc-500 [&_a]:no-underline [&_a:hover]:text-zinc-950 [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-4 [&_a:focus-visible]:outline-zinc-800">
        {site.legalName} · <a href="/privacy/">Privacy</a> · <a href="/cookies/">Cookies</a>
      </p>
    </div>
  </div>
</Layout>
