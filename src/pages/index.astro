        <ul
          class="border rounded-lg border-gray-300 overflow-hidden divide-y divide-gray-300 -mx-4"
        >
          <li class="hover:bg-white">
            <a
              href="https://github.com/jxdltd/holistic-starter"
              target="_blank"
              class="p-4 flex flex-col"
            >
              <span class="font-bold">Starter</span>
              <span class="text-sm text-gray-500"
                >An open-source TanStack-based starter kit for building web apps
                at speed.</span
              >
            </a>
          </li>
        </ul>
      </section>

