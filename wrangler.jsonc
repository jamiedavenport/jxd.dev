{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jxd-dev",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "routes": [
    { "pattern": "www.jxd.dev", "custom_domain": true },
    { "pattern": "jxd.dev", "custom_domain": true }
  ]
}
