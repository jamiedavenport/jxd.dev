{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jxd-dev",
  "compatibility_date": "2026-09-07",
  "routes": [
    {
      "pattern": "jxd.dev",
      "custom_domain": true,
    },
    {
      "pattern": "www.jxd.dev",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
